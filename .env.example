# Copiar a .env y cambiar la contraseña. docker-compose.yml y Prisma leen estas variables.
POSTGRES_USER=miterza
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=miterza
POSTGRES_PORT=5440

DATABASE_URL="postgresql://miterza:cambia-esta-contrasena@localhost:5440/miterza?schema=public"

# Auth.js: firma de las sesiones del panel. Genera uno con: openssl rand -base64 33
AUTH_SECRET="cambia-este-secreto"

# Administrador inicial que crea el seed (solo si no existe; no cambia una contraseña existente).
ADMIN_EMAIL="admin@miterza.local"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NAME="Administrador"
